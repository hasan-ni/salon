PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/salon
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# First admin account. Created automatically the first time the server starts (or with `npm run seed`)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password

# Set to the salon's timezone so "today" and opening hours are correct, e.g. TZ=Europe/London
# TZ=

# Only if your network cannot look up mongodb+srv:// addresses
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Real SMS through Twilio (optional; without it codes only appear in the server log)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=
