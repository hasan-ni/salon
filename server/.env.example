PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/salon
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# First admin account. Created automatically the first time the server starts (or with `npm run seed`)
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-this-password

# The salon's timezone, so "today", opening hours and past-time checks are right, e.g. SALON_TZ=Europe/London
SALON_TZ=Europe/London

# Only if your network cannot look up mongodb+srv:// addresses
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Real SMS through Twilio (optional; without it codes only appear in the server log)
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# Phone alerts (push notifications). Make the keys with: npm run vapid  (inside the server folder)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# Email (sign-in codes and message copies) through Brevo's free plan. Both are needed.
# BREVO_API_KEY=
# MAIL_FROM=                  a sender address you verified in Brevo

# Free sign-in with WhatsApp (see the steps in the README). All five are needed.
# WHATSAPP_NUMBER=            the salon's WhatsApp number, digits only with country code
# WHATSAPP_PHONE_ID=          "Phone number ID" from the Meta developer dashboard
# WHATSAPP_TOKEN=             permanent access token
# WHATSAPP_VERIFY_TOKEN=      any private text you choose; you type the same into Meta
# WHATSAPP_APP_SECRET=        "App secret" from the Meta app settings
